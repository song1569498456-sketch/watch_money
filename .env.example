# Public exchange market data needs no user trading account.
WATCH_MONEY_DATA_DIR=data
WATCH_MONEY_COLLECT=1
# Optional external notifications (leave blank for local/mock testing).
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional original Drift metadata reader; execution/current lifecycle are unverified.
SOLANA_RPC_URL=
# HTTPS_PROXY / HTTP_PROXY are inherited. Never commit private proxy/RPC credentials.
# RPC-dependent adapters list any additional conditions in docs/COVERAGE.md.

# Optional CoinGecko Demo catalog hints; key is server-only, never a trading credential.
COINGECKO_DEMO_API_KEY=
